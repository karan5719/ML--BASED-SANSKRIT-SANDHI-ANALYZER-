# Google Cloud Translation API (enable Cloud Translation API on your GCP project)
GOOGLE_TRANSLATE_API_KEY=

# Optional: same key under a generic name
# GOOGLE_API_KEY=

# Groq API for AI-powered shloka analysis
GROQ_API_KEY=

# CORS for FastAPI (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# IndicBERT / mBERT Hugging Face model id (default: ai4bharat/indic-bert)
# INDICBERT_MODEL_ID=bert-base-multilingual-cased

# Model bundle: default = bilstm_sandhi.pt + enhanced_crf_pos_model_v3.pkl + sandhi_vocab.json (vocab if needed)
# processed = models/processed_data/* only. Per-file env vars still override when set to existing paths.
# SANSKRIT_MODEL_PRESET=default
# SANSKRIT_MODEL_PRESET=processed
# POS_MODEL_PATH=
# SANDHI_BILSTM_PATH=
# SANDHI_VOCAB_PATH=
